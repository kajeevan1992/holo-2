# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/holo_print
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/holo_print
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT_SECONDS=20

# Admin bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bank transfer
BANK_TRANSFER_ENABLED=true
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=HOLO Print <orders@example.com>

# Upload storage
UPLOAD_STORAGE_DRIVER=local
UPLOAD_STORAGE_PATH=./storage/uploads
MAX_ARTWORK_FILE_MB=100
